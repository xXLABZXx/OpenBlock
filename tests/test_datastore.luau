-- Tier 1: DataStoreService (synchronous, in-memory prototype).
local DSS = game:GetService("DataStoreService")

compat.check("DataStoreService GetDataStore caches", function()
	local a = DSS:GetDataStore("CacheA")
	local b = DSS:GetDataStore("CacheA")
	assert(a == b, "same name did not return the cached store")
	local scoped = DSS:GetDataStore("CacheA", "Season2")
	assert(scoped ~= a, "different scope should be a different store")
	assert(a.Name == "CacheA")
end)

compat.check("DataStore SetAsync GetAsync round trip", function()
	local ds = DSS:GetDataStore("RoundTrip")
	ds:SetAsync("n", 42)
	assert(ds:GetAsync("n") == 42)
	ds:SetAsync("s", "hi")
	assert(ds:GetAsync("s") == "hi")
	ds:SetAsync("b", true)
	assert(ds:GetAsync("b") == true)
	assert(ds:GetAsync("missing") == nil)
end)

compat.check("DataStore IncrementAsync", function()
	local ds = DSS:GetDataStore("Incr")
	ds:RemoveAsync("k")
	assert(ds:IncrementAsync("k") == 1)
	assert(ds:IncrementAsync("k", 4) == 5)
	assert(ds:GetAsync("k") == 5)
end)

compat.check("DataStore UpdateAsync transforms", function()
	local ds = DSS:GetDataStore("Upd")
	ds:SetAsync("k", 10)
	local out = ds:UpdateAsync("k", function(v)
		return v * 2
	end)
	assert(out == 20, "UpdateAsync returned " .. tostring(out))
	assert(ds:GetAsync("k") == 20)
end)

compat.check("DataStore RemoveAsync clears", function()
	local ds = DSS:GetDataStore("Rem")
	ds:SetAsync("k", "v")
	ds:RemoveAsync("k")
	assert(ds:GetAsync("k") == nil)
end)

compat.check("DataStore rejects unsupported values", function()
	local ds = DSS:GetDataStore("Types")
	local ok = pcall(function()
		ds:SetAsync("k", {})
	end)
	assert(not ok, "table value was accepted")
end)
